CLAIM_GUARD_DATABASE_URL=sqlite:///./data/claim_guard.db
CLAIM_GUARD_STORAGE_DIR=./data/storage
# Use "auto" before Azure is configured. After adding the company endpoint and
# key, change this to "azure" so errors are reported directly and the app never
# attempts local Tesseract on a company laptop.
CLAIM_GUARD_DOCUMENT_OCR_PROVIDER=auto
CLAIM_GUARD_AZURE_DOCUMENT_ENDPOINT=
CLAIM_GUARD_AZURE_DOCUMENT_API_KEY=
CLAIM_GUARD_AZURE_DOCUMENT_MODEL=prebuilt-layout
CLAIM_GUARD_AZURE_DOCUMENT_TIMEOUT_SECONDS=120
CLAIM_GUARD_LLM_PROVIDER=gemini
CLAIM_GUARD_LLM_API_KEY=
