CLAIM_GUARD_DATABASE_URL=sqlite:///./data/claim_guard.db
CLAIM_GUARD_STORAGE_DIR=./data/storage
# Use "auto" before Azure is configured. After adding the company endpoint and
# key, change this to "azure" so errors are reported directly and the app never
# attempts local Tesseract on a company laptop.
CLAIM_GUARD_DOCUMENT_OCR_PROVIDER=auto
CLAIM_GUARD_AZURE_DOCUMENT_ENDPOINT=
CLAIM_GUARD_AZURE_DOCUMENT_API_KEY=
CLAIM_GUARD_AZURE_DOCUMENT_MODEL=prebuilt-layout
CLAIM_GUARD_AZURE_DOCUMENT_TIMEOUT_SECONDS=120
CLAIM_GUARD_LLM_PROVIDER=gemini
CLAIM_GUARD_LLM_MODEL=gemini-2.5-flash-lite
CLAIM_GUARD_LLM_API_KEY=
CLAIM_GUARD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CLAIM_GUARD_LLM_VISION_ENABLED=false
CLAIM_GUARD_LLM_VISION_MODEL=
CLAIM_GUARD_LLM_API_VERSION=2024-10-21
CLAIM_GUARD_LLM_VISION_MAX_PAGES=8
CLAIM_GUARD_LLM_VISION_MAX_BATCHES=3

# Azure AI / Azure OpenAI example. Use a rotated secret and the endpoint supplied
# for the model deployment; these are separate from Document Intelligence above.
# CLAIM_GUARD_LLM_PROVIDER=azure_openai
# CLAIM_GUARD_LLM_MODEL=your-text-model-or-deployment
# CLAIM_GUARD_LLM_VISION_MODEL=your-image-capable-model-or-deployment
# CLAIM_GUARD_LLM_API_KEY=
# CLAIM_GUARD_LLM_BASE_URL=https://your-resource.services.ai.azure.com
# CLAIM_GUARD_LLM_API_VERSION=2024-05-01-preview
# CLAIM_GUARD_LLM_VISION_ENABLED=true
